# Backend Dockerfile for DengueWatch KL
# FastAPI + Ultralytics YOLO + PostgreSQL client

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies for PostGIS, Pillow, and compilation
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    g++ \
    libglib2.0-0 \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY backend/requirements.txt /app/requirements.txt
COPY backend/constraints-cpu.txt /app/constraints-cpu.txt

# Install CPU-only PyTorch before the application dependencies. The EC2
# deployment hosts do not have an NVIDIA GPU, so the default PyPI wheels
# would unnecessarily pull several gigabytes of CUDA runtime packages.
RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==2.13.0+cpu torchvision==0.28.0+cpu \
    && pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      --constraint constraints-cpu.txt \
      -r requirements.txt \
    && python -c "import torch; assert torch.version.cuda is None; assert not torch.cuda.is_available(); print('CPU-only PyTorch verified')"

# Copy backend application code
COPY backend/app /app/app
COPY backend/migrations /app/migrations
COPY backend/alembic.ini /app/alembic.ini

# Copy service area boundary geojson needed for location validation
COPY src/data/kuala-lumpur-boundary.geojson /src/data/kuala-lumpur-boundary.geojson

# Create directories for uploads and models
RUN mkdir -p /app/uploads /app/models

# Copy the selected deployment checkpoint
COPY backend/models/denguewatch_yolov8s_best.pt /app/models/denguewatch_yolov8s_best.pt

# Verify model file exists
RUN ls -lh /app/models/denguewatch_yolov8s_best.pt

# Environment variables (will be overridden by docker-compose)
ENV PYTHONUNBUFFERED=1
ENV MODEL_PATH=/app/models/denguewatch_yolov8s_best.pt
ENV UPLOAD_ROOT=/app/uploads

# Expose port
EXPOSE 8000

# Health check using Python standard library (no external dependencies needed)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health', timeout=5)"

# Run uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Production Environment Variables for DengueWatch KL
# This file is a schema and example only — it contains no real credentials.
#
# Authoritative production configuration should live in AWS Systems Manager
# Parameter Store as a SecureString. The EC2 deploy script fetches that
# parameter, validates it, and writes the runtime .env.production file locally
# with mode 600. Never commit the real .env.production to version control.

# ============================================================================
# DATABASE (RDS PostgreSQL + PostGIS)
# ============================================================================
# Format: postgresql+psycopg://USERNAME:PASSWORD@RDS_ENDPOINT:5432/DB_NAME
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT.rds.amazonaws.com:5432/YOUR_DB_NAME

# ============================================================================
# MODEL PATH (Backend)
# ============================================================================
# Path to the YOLO model checkpoint inside the backend container.
# Override here only if you change the path in docker-compose.prod.yml.
MODEL_PATH=/app/models/denguewatch_yolov8s_best.pt

# ============================================================================
# UPLOAD ROOT (Backend)
# ============================================================================
# Local upload directory inside the backend container.
# Used as a fallback write location when STORAGE_BACKEND=local, or as a
# temporary buffer before S3 upload when STORAGE_BACKEND=s3.
UPLOAD_ROOT=/app/uploads

# ============================================================================
# STORAGE BACKEND
# ============================================================================
# "local"  — store evidence images on the container filesystem only
# "s3"     — upload images to S3 (recommended for production)
STORAGE_BACKEND=s3
S3_BUCKET=YOUR_S3_BUCKET_NAME
S3_REGION=YOUR_AWS_REGION
S3_PRESIGNED_URL_EXPIRES_SECONDS=3600

# Optional: delete local copies after a successful S3 upload to save disk space.
# Set to "true" in disk-constrained environments; "false" keeps local copies as backup.
# CLEANUP_LOCAL_AFTER_S3_UPLOAD=false

# ============================================================================
# CORS ORIGINS (Allowed Frontend Origins)
# ============================================================================
# Comma-separated list. Include your production domain and any CDN origin.
CORS_ORIGINS=https://YOUR_PRODUCTION_DOMAIN

# ============================================================================
# AWS COGNITO — RESIDENT AUTHENTICATION
# ============================================================================
# Backend verifies Cognito ID tokens for authenticated report submission.
# Values must match the frontend VITE_COGNITO_* variables exactly.
COGNITO_REGION=YOUR_AWS_REGION
COGNITO_USER_POOL_ID=YOUR_COGNITO_USER_POOL_ID
COGNITO_APP_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID

# ============================================================================
# FRONTEND BUILD VARIABLES (public — not secrets)
# ============================================================================
# These are baked into the frontend at build time by Vite.
# Cognito identifiers are public configuration; do not place App Client secrets here.
VITE_AUTH_MODE=cognito
VITE_API_BASE_URL=/api
VITE_COGNITO_REGION=YOUR_AWS_REGION
VITE_COGNITO_USER_POOL_ID=YOUR_COGNITO_USER_POOL_ID
VITE_COGNITO_USER_POOL_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
VITE_COGNITO_HOSTED_UI_DOMAIN=YOUR_COGNITO_HOSTED_UI_DOMAIN
VITE_COGNITO_REDIRECT_SIGN_IN=https://YOUR_PRODUCTION_DOMAIN/profile
VITE_COGNITO_REDIRECT_SIGN_OUT=https://YOUR_PRODUCTION_DOMAIN/

# ============================================================================
# OPTIONAL: iDengue Hotspot Endpoint Override
# ============================================================================
# Leave commented to use the default Malaysian iDengue ArcGIS service.
# IDENGUE_HOTSPOT_ENDPOINT=https://mygis.mysa.gov.my/erica1/rest/services/iDengue/WM_idengue/MapServer/0/query

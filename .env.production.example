# Production Environment Variables for DengueWatch KL
# This file is a schema and example only.
#
# Authoritative production configuration should live in AWS Systems Manager
# Parameter Store as a SecureString, for example:
#   /denguewatch/production/env
#
# The EC2 deploy script fetches that parameter, validates it, and writes the
# runtime .env.production file locally with mode 600.

# ============================================================================
# DATABASE (RDS PostgreSQL + PostGIS)
# ============================================================================
# Format: postgresql+psycopg://USERNAME:PASSWORD@ENDPOINT:5432/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://postgres:YOUR_RDS_PASSWORD@denguewatch-noorullah-db.xxxxx.us-east-1.rds.amazonaws.com:5432/denguewatch

# ============================================================================
# MODEL PATH (Backend)
# ============================================================================
# Path to YOLO model inside the backend container
# This is set automatically in docker-compose, but can be overridden here
MODEL_PATH=/app/models/best.pt

# ============================================================================
# UPLOAD ROOT (Backend)
# ============================================================================
# Path to uploads directory inside the backend container
# This is set automatically in docker-compose, but can be overridden here
UPLOAD_ROOT=/app/uploads

STORAGE_BACKEND=s3
S3_BUCKET=denguewatch-noorullah-uploads-2026
S3_REGION=ap-southeast-1
S3_PRESIGNED_URL_EXPIRES_SECONDS=3600

# Optional: Delete local files after successful S3 upload to save disk space
# Set to "true" to enable, "false" or leave unset to keep local copies as backup
# CLEANUP_LOCAL_AFTER_S3_UPLOAD=false

# ============================================================================
# CORS ORIGINS (Frontend URL)
# ============================================================================
# Multiple origins separated by commas
CORS_ORIGINS=https://denguewatch.example.com

# ============================================================================
# AWS COGNITO USER AUTHENTICATION
# ============================================================================
# Get these values from AWS Console > Cognito > User Pools
# After creating your Cognito User Pool and App Client, fill these in:
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=1234567890abcdefghijklmnop

# Frontend Cognito configuration (public build-time identifiers, not secrets)
VITE_AUTH_MODE=cognito
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=1234567890abcdefghijklmnop
VITE_COGNITO_HOSTED_UI_DOMAIN=auth.denguewatch.example.com
VITE_COGNITO_REDIRECT_SIGN_IN=https://denguewatch.example.com/profile
VITE_COGNITO_REDIRECT_SIGN_OUT=https://denguewatch.example.com/

# ============================================================================
# FRONTEND API BASE URL
# ============================================================================
# Use same-origin API routing in production unless you intentionally split origins
VITE_API_BASE_URL=/api

# ============================================================================
# OPTIONAL: iDengue Hotspot Endpoint Override
# ============================================================================
# Leave commented to use default Malaysian iDengue service
# IDENGUE_HOTSPOT_ENDPOINT=https://mygis.mysa.gov.my/erica1/rest/services/iDengue/WM_idengue/MapServer/0/query
